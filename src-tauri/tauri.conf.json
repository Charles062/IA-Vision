{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "openvy-win",
  "version": "0.1.0",
  "identifier": "com.openvy.win",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "OpenVy-Win",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "externalBin": []
  }
}